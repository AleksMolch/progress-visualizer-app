{
  "expo": {
    "name": "progress-visualizer-app",
    "slug": "progress-visualizer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "progressvisualizerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ru.nov.molcha.progressvisualizer",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "ru.nov.molcha.progressvisualizer",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0B0D12",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Приложению нужен доступ к камере, чтобы делать фотографии прогресса.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите доступ к Face ID, чтобы защитить фотографии приложения."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Приложению нужен доступ к сохранению, чтобы экспортировать снимки прогресса в галерею.",
          "granularPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af2e8419-a900-4483-b5d3-1ab27d411f6b"
      },
      "privacyPolicyUrl": "https://aleksmolch.github.io/progress-visualizer-app/privacy-policy.html"
    },
    "owner": "alomium"
  }
}
